  "private": true,
  "description": "A batteries-included, framework-agnostic authentication & anti-abuse protection SDK.",
  "license": "MIT",
  "author": "DiamondPie <thelostdiamondpie@outlook.com>",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
