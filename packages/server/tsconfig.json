{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    // The security guard has to run unchanged on Node, Vercel Edge and Cloudflare Workers.
    // WebWorker models exactly that surface — fetch/Request/Response/URLSearchParams, no
    // `document` — so a Node-only API cannot slip into the guard path unnoticed.
    "lib": ["ES2022", "WebWorker"],
    "types": [],
    "outDir": "dist",
    "rootDir": "src",
    // Kept out of `dist`, which `files: ["dist"]` publishes and tsdown wipes on every
    // build: an incremental cache does not belong in a tarball, and whether it landed in
    // one came down to whether `tsc` or `tsdown` ran last.
    "tsBuildInfoFile": "./.tsbuildinfo"
  },
  "include": ["src"],
  "references": [{ "path": "../core" }]
}
