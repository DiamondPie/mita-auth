{
  "name": "@mita-auth/server",
  "version": "0.0.0",
  "description": "Node.js / Edge runtime server helpers: rate limiting, Turnstile verification, replay protection.",
  "license": "MIT",
  "keywords": [
    "mita",
    "rate-limit",
    "turnstile",
    "replay-protection",
    "dpop",
    "upstash",
    "xss",
    "edge"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiamondPie/mita-auth.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/DiamondPie/mita-auth/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/DiamondPie/mita-auth/issues"
  },
  "author": "DiamondPie <thelostdiamondpie@outlook.com>",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./memory": {
      "import": {
        "types": "./dist/memory.d.mts",
        "default": "./dist/memory.mjs"
      },
      "require": {
        "types": "./dist/memory.d.cts",
        "default": "./dist/memory.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "memory": ["./dist/memory.d.cts"]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --coverage",
    "test:edge": "vitest run --config vitest.edge.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:exports": "attw --pack .",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@mita-auth/core": "workspace:*",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "msw": "^2.15.0"
  }
}
