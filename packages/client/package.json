{
  "name": "@mita-auth/client",
  "version": "0.0.0",
  "description": "Browser client: protected fetch (ky), reactive auth state (nanostores), <mita-turnstile> web component.",
  "license": "MIT",
  "author": "DiamondPie <thelostdiamondpie@outlook.com>",
  "type": "module",
  "sideEffects": ["./dist/turnstile.mjs", "./dist/turnstile.cjs"],
  "files": ["dist"],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./turnstile": {
      "import": {
        "types": "./dist/turnstile.d.mts",
        "default": "./dist/turnstile.mjs"
      },
      "require": {
        "types": "./dist/turnstile.d.cts",
        "default": "./dist/turnstile.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "turnstile": ["./dist/turnstile.d.cts"]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:exports": "attw --pack .",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@mita-auth/core": "workspace:*",
    "ky": "^2.0.2",
    "nanostores": "^1.4.1"
  },
  "devDependencies": {
    "@mita-auth/server": "workspace:*",
    "happy-dom": "^20.11.1",
    "msw": "^2.15.0"
  }
}
