{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    // @mita-auth/core must run on Node, browsers, Workers and Deno alike. The WebWorker lib
    // models exactly that surface: standard Web APIs without `document`/`window`, and
    // `types: []` keeps @types/node from silently making Node-only APIs compile.
    "lib": ["ES2022", "WebWorker"],
    "types": [],
    "outDir": "dist",
    "rootDir": "src",
    // Kept out of `dist`, which `files: ["dist"]` publishes and tsdown wipes on every
    // build: an incremental cache does not belong in a tarball, and whether it landed in
    // one came down to whether `tsc` or `tsdown` ran last.
    "tsBuildInfoFile": "./.tsbuildinfo"
  },
  "include": ["src"]
}
