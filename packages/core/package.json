{
  "name": "@mita-auth/core",
  "version": "0.1.0",
  "description": "Framework-agnostic core: DPoP signing, nonce generation, and the shared Zod schemas behind a Zod-free main entry.",
  "license": "MIT",
  "keywords": [
    "mita",
    "dpop",
    "rfc9449",
    "proof-of-possession",
    "nonce",
    "zod",
    "edge",
    "anti-abuse"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiamondPie/mita-auth.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/DiamondPie/mita-auth/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/DiamondPie/mita-auth/issues"
  },
  "author": "DiamondPie <thelostdiamondpie@outlook.com>",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schemas": {
      "import": {
        "types": "./dist/schemas.d.mts",
        "default": "./dist/schemas.mjs"
      },
      "require": {
        "types": "./dist/schemas.d.cts",
        "default": "./dist/schemas.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "schemas": [
        "./dist/schemas.d.cts"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:exports": "attw --pack .",
    "lint:publish": "publint --strict",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "jose": "^6.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "rolldown": "^1.2.0"
  }
}
